  pages   = {351--357},
  doi     = {10.1103/PhysRev.67.351},
  note    = {Closed-form demagnetizing factors for a general ellipsoid; the three principal factors sum to 1, giving N = 1/3 for a sphere. Two consequences for MIME-NODE-009: (1) N = 1/3 is INDEPENDENT OF SIZE, which is what makes the volume scaling m ~ V exact for spheres and the 1.69-vs-1.4 mm sweep free; (2) chi_eff = chi/(1 + N chi) is bounded above by 1/N = 3, the ceiling MIME-NODE-002 hardwires.},
}

