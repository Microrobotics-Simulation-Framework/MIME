#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def "Arm" (
        prepend references = @./layers/arm_visual.usda@
    )
    {
    }

    def Scope "bath"
    {
        custom string mime:name = "bath"
        custom token mime:thing = "medium"
    }

    def Xform "probe"
    {
        custom string mime:name = "probe"
        custom token mime:thing = "body"
        double3 xformOp:translate = (0.3, -0.2, 0.1)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Scope "source"
    {
        custom string mime:name = "source"
        custom token mime:thing = "apparatus"
    }
}

