#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def "vessel_scan" (
        prepend references = @./layers/vessel_scan.usda@
    )
    {
    }

    def Scope "hub"
    {
        custom string mime:name = "hub"
        custom token mime:thing = "apparatus"

        def Xform "arm"
        {
            custom string mime:segment = "arm 0.1.0 (rung dynamic)"
            quatd xformOp:orient = (1, 0, 0, 0)
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

            def Xform "base_link"
            {
                custom string mime:frame = "base_link"
                quatd xformOp:orient = (1, 0, 0, 0)
                double3 xformOp:translate = (0, 0, 0)
                uniform token[] xformOpOrder = ["!resetXformStack!", "xformOp:translate", "xformOp:orient"]
            }

            def Xform "hub"
            {
                custom string mime:frame = "hub"
                quatd xformOp:orient = (1, 0, 0, 0)
                double3 xformOp:translate = (0, 0, 0)
                uniform token[] xformOpOrder = ["!resetXformStack!", "xformOp:translate", "xformOp:orient"]

                def "visuals"
                {
                    def Xform "visual_0"
                    {
                        custom string mime:visual:asset = "hub_meshes"
                        custom string mime:visual:file = "meshes/hub.stl"
                        custom token mime:visual:role = "visual"
                        custom string mime:visual:sha256 = "efefefefefefefefefefefefefefefefefefefefefefefefefefefefefefefef"
                        custom color3f[] primvars:displayColor = [(0.7, 0.7, 0.72)]
                        quatd xformOp:orient = (1, 0, 0, 0)
                        double3 xformOp:translate = (0, 0, 0)
                        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
                    }
                }
            }
        }
    }

    def Xform "probe"
    {
        custom string mime:name = "probe"
        custom token mime:thing = "body"
        double3 xformOp:translate = (0.3, -0.2, 0.1)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}

