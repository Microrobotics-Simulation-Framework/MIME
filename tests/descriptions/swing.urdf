<?xml version="1.0"?>
<!--
  swing.urdf

  One continuous joint about the world's +x carrying a light pendulum, its centre of mass 5 cm below the joint: a
  rotor on its axis spun about the link's +z, across the joint, so that the joint bears the rotor's gyroscopic torque
  and its inertia across its axis loads the swing (tests/oracles/test_spinner_tree.py). No damping, no friction.
-->
<robot name="swing">

  <link name="base"/>

  <joint name="swing" type="continuous">
    <parent link="base"/>
    <child link="arm"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit effort="10" velocity="2.0"/>
  </joint>

  <link name="arm">
    <inertial>
      <origin xyz="0 0 -0.05" rpy="0 0 0"/>
      <mass value="0.02"/>
      <inertia ixx="1.0e-5" ixy="0.0" ixz="0.0" iyy="1.0e-5" iyz="0.0" izz="2.0e-6"/>
    </inertial>
  </link>

</robot>
