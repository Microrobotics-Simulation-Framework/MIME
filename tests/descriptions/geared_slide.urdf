<?xml version="1.0"?>
<!--
  geared_slide.urdf

  One prismatic joint along the world's +x carrying a carriage of 0.5 kg, driven by a lead screw of 5 mm lead through a
  simple transmission in the older mechanism model's form (its type an attribute, its reduction its own child): the
  actuator slide_motor turns 2 pi / 0.005 = 1256.6371 rad for each metre the carriage travels, so a rotor of inertia J
  behind it reflects 1256.6371^2 J onto the slide as its armature, a mass. Travel 0.2 m either way, at most 0.1 m/s.
  No damping and no friction.
-->
<robot name="geared_slide">

  <link name="base_link"/>

  <joint name="slide" type="prismatic">
    <parent link="base_link"/>
    <child link="carriage"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.2" upper="0.2" effort="50" velocity="0.1"/>
  </joint>

  <link name="carriage">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="1.0e-4" ixy="0.0" ixz="0.0" iyy="1.0e-4" iyz="0.0" izz="1.0e-4"/>
    </inertial>
  </link>

  <transmission name="slide_screw" type="pr2_mechanism_model/SimpleTransmission">
    <joint name="slide"/>
    <actuator name="slide_motor"/>
    <mechanicalReduction>1256.6370614359173</mechanicalReduction>
  </transmission>

</robot>
